{%- if block.settings.text != blank -%}
  <p class="knr-reassurance__slide" data-knr-slide {{ block.shopify_attributes }}>
    {{- block.settings.text -}}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Reassurance message",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Reassurance message"
    }
  ]
}
{% endschema %}
