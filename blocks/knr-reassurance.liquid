{% doc %}
  @example
  {% content_for 'block', type: 'knr-reassurance', id: 'reassurance' %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign interval = block.settings.interval | times: 1000
  assign in_stock_template = 'knr.product.in_stock_delivery' | t: date: '[date]'
-%}

<knr-reassurance
  class="knr-reassurance"
  data-interval="{{ interval }}"
  data-label-go-to="{{ 'knr.reassurance.go_to' | t: index: '[index]' }}"
  {{ block.shopify_attributes }}
>
  <div class="knr-reassurance__slides" data-knr-slides aria-live="off">
    <p
      class="knr-reassurance__slide"
      data-knr-slide
      data-knr-stock
      data-in-stock="{{ in_stock_template | escape }}"
      data-out-of-stock="{{ 'knr.product.out_of_stock' | t | escape }}"
      data-delivery-days="{{ block.settings.delivery_days }}"
    >
      {%- if variant.available -%}
        {{- 'knr.product.in_stock' | t -}}
      {%- else -%}
        {{- 'knr.product.out_of_stock' | t -}}
      {%- endif -%}
    </p>

    {% content_for 'blocks' %}
  </div>
</knr-reassurance>

<script src="{{ 'knr-reassurance.js' | asset_url }}" defer></script>

{% stylesheet %}
  .knr-reassurance {
    display: block;
    font-size: var(--knr-fs-2xs);
    line-height: var(--knr-lh-xs);
    text-align: center;
  }

  .knr-reassurance__slide {
    margin: 0;
  }

  .knr-reassurance__slide a {
    color: inherit;
  }

  .knr-reassurance:defined .knr-reassurance__slides {
    display: grid;
  }

  .knr-reassurance__slides > .shopify-block {
    display: contents;
  }

  .knr-reassurance:defined .knr-reassurance__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 600ms ease,
      visibility 600ms ease;
  }

  .knr-reassurance:defined .knr-reassurance__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .knr-reassurance:defined .knr-reassurance__slide {
      transition: none;
    }
  }

  .knr-reassurance__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--knr-space-xs);
    margin-top: var(--knr-space-sm);
  }

  .knr-reassurance__dots {
    display: flex;
    gap: 0.375rem;
  }

  .knr-reassurance__dot {
    display: flex;
    align-items: center;
    width: 0.75rem;
    height: 1rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .knr-reassurance__dot::before {
    content: '';
    width: 100%;
    height: 1px;
    background-color: var(--knr-color-border);
  }

  .knr-reassurance__dot[aria-current='true']::before {
    background-color: var(--knr-color-text);
  }

  .knr-reassurance__dot:focus-visible {
    outline: 1px solid var(--knr-color-text);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stock and reassurance",
  "settings": [
    {
      "type": "range",
      "id": "delivery_days",
      "label": "Estimated delivery time",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "j",
      "default": 2,
      "info": "In business days, shown in the stock message"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Duration of each message",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "_knr-reassurance-message"
    }
  ]
}
{% endschema %}
