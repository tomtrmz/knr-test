{% doc %}
  @param {product} product - The product whose images are rendered
  @param {string} [labels] - Pre-rendered labels HTML, overlaid on the first image on mobile

  @example
  {% render 'knr-product-gallery', product: product, labels: labels_html %}
{% enddoc %}

{%- liquid
  assign images = product.media | where: 'media_type', 'image'
  assign gallery_label = 'knr.product.gallery' | t
  assign mobile_featured_image = product.metafields.custom.mobile_featured_image.value

  assign images_modulo = images.size | modulo: 2
  assign last_is_alone = false
  if images.size > 1 and images_modulo == 0
    assign last_is_alone = true
  endif
-%}

<knr-product-zoom class="knr-product-gallery">
  {%- if labels != blank -%}
    <div class="knr-product-gallery__labels">{{ labels }}</div>
  {%- endif -%}

  <knr-carousel class="knr-product-gallery__carousel" data-hide-at-edges>
    <ul class="knr-product-gallery__list" role="list" aria-label="{{ gallery_label }}" data-knr-carousel-track>
      {%- for media in images -%}
        {%- liquid
          assign media_alt = media.alt | default: product.title
          assign item_modifier = ''
          if forloop.first
            assign sizes = '100vw'
            assign loading = 'eager'
            assign fetchpriority = 'high'
          elsif forloop.last and last_is_alone
            assign item_modifier = ' knr-product-gallery__item--wide'
            assign sizes = '(min-width: 990px) 68vw, 100vw'
            assign loading = 'lazy'
            assign fetchpriority = 'auto'
          else
            assign sizes = '(min-width: 990px) 34vw, 100vw'
            assign loading = 'lazy'
            assign fetchpriority = 'auto'
          endif
        -%}
        <li class="knr-product-gallery__item{{ item_modifier }}" data-media-id="{{ media.id }}">
          {%- if forloop.first and mobile_featured_image -%}
            <picture>
              <source
                media="(max-width: 989px)"
                srcset="
                  {{- mobile_featured_image | image_url: width: 375 }} 375w,
                  {{ mobile_featured_image | image_url: width: 750 }} 750w,
                  {{ mobile_featured_image | image_url: width: 1100 }} 1100w
                "
                sizes="100vw"
              >
          {%- endif -%}
          {{
            media
            | image_url: width: 2400
            | image_tag:
              class: 'knr-product-gallery__image',
              widths: '375, 550, 750, 1100, 1500, 1800, 2400',
              sizes: sizes,
              loading: loading,
              fetchpriority: fetchpriority,
              alt: media_alt
          }}
          {%- if forloop.first and mobile_featured_image -%}
            </picture>
          {%- endif -%}
          <button
            type="button"
            class="knr-product-gallery__zoom"
            data-knr-zoom-open="{{ forloop.index0 }}"
            aria-haspopup="dialog"
            aria-label="{{ 'knr.product.zoom_open' | t: index: forloop.index, count: images.size }}"
          >
            {% render 'knr-icon', name: 'plus' %}
          </button>
        </li>
      {%- else -%}
        <li class="knr-product-gallery__item">
          {{ 'product-1' | placeholder_svg_tag: 'knr-product-gallery__image knr-product-gallery__image--placeholder' }}
        </li>
      {%- endfor -%}
    </ul>

    {%- if images.size > 1 -%}
      <button
        type="button"
        class="knr-product-gallery__arrow knr-product-gallery__arrow--prev"
        data-knr-carousel-prev
        hidden
        aria-label="{{ 'knr.product.gallery_previous' | t | escape }}"
      >
        <span class="knr-product-gallery__arrow-icon">{% render 'knr-icon', name: 'chevron-down' %}</span>
      </button>
      <button
        type="button"
        class="knr-product-gallery__arrow knr-product-gallery__arrow--next"
        data-knr-carousel-next
        aria-label="{{ 'knr.product.gallery_next' | t | escape }}"
      >
        <span class="knr-product-gallery__arrow-icon">{% render 'knr-icon', name: 'chevron-down' %}</span>
      </button>
      <div class="knr-product-gallery__progress">
        {% render 'knr-carousel-progress' %}
      </div>
      <script src="{{ 'knr-carousel.js' | asset_url }}" defer></script>
    {%- endif -%}
  </knr-carousel>

  {%- if images.size > 0 -%}
    <dialog class="knr-product-zoom" aria-label="{{ 'knr.product.zoom_label' | t | escape }}" data-knr-zoom-dialog>
      <form method="dialog" class="knr-product-zoom__close-form">
        <button type="submit" class="knr-product-zoom__close" aria-label="{{ 'knr.product.zoom_close' | t | escape }}">
          {% render 'knr-icon', name: 'close' %}
        </button>
      </form>
      <ul class="knr-product-zoom__list" role="list">
        {%- for media in images -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <li data-knr-zoom-item>
            {{
              media
              | image_url: width: 2880
              | image_tag:
                class: 'knr-product-zoom__image',
                widths: '750, 1100, 1500, 1920, 2400, 2880',
                sizes: '100vw',
                loading: 'lazy',
                alt: media_alt
            }}
          </li>
        {%- endfor -%}
      </ul>
    </dialog>
    <script src="{{ 'knr-product-zoom.js' | asset_url }}" defer></script>
  {%- endif -%}
</knr-product-zoom>

{% stylesheet %}
  .knr-product-gallery {
    position: relative;
    display: block;
  }

  .knr-product-gallery__labels {
    position: absolute;
    z-index: 1;
    top: calc(var(--knr-header-height) + var(--knr-space-md));
    inset-inline: 0;
    display: flex;
    justify-content: center;
  }

  .knr-product-gallery__list {
    display: flex;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .knr-product-gallery__item {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .knr-product-gallery__zoom {
    position: absolute;
    display: none;
    right: var(--knr-space-xs);
    bottom: var(--knr-space-xs);
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--knr-color-bg);
    cursor: zoom-in;
  }

  .knr-product-gallery__zoom .knr-icon {
    width: 0.5rem;
    height: 0.5rem;
  }

  .knr-product-gallery__zoom:focus-visible {
    outline: 1px solid currentcolor;
    outline-offset: -0.5rem;
  }

  .knr-product-gallery:not(:defined) .knr-product-gallery__zoom {
    display: none;
  }

  .knr-product-zoom {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--knr-color-bg);
    overscroll-behavior: contain;
  }

  .knr-product-zoom::backdrop {
    background-color: var(--knr-color-bg);
  }

  .knr-product-zoom__close-form {
    position: fixed;
    top: var(--knr-space-md);
    right: var(--knr-space-md);
    z-index: 1;
  }

  .knr-product-zoom__close {
    display: grid;
    place-items: center;
    width: var(--knr-control-height);
    height: var(--knr-control-height);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--knr-color-bg);
    color: var(--knr-color-text);
    cursor: pointer;
  }

  .knr-product-zoom__close:focus-visible {
    outline: 1px solid currentcolor;
    outline-offset: 2px;
  }

  .knr-product-zoom__list {
    display: grid;
    gap: var(--knr-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knr-product-zoom__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .knr-product-gallery__carousel {
    position: relative;
    display: block;
  }

  .knr-product-gallery__arrow {
    position: absolute;
    top: calc((100% - var(--knr-product-panel-overlap, 0px)) / 2);
    z-index: 1;
    display: flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 var(--knr-space-md);
    border: 0;
    background: none;
    color: var(--knr-color-text);
    cursor: pointer;
    translate: 0 -50%;
  }

  .knr-product-gallery__arrow[hidden] {
    display: none;
  }

  .knr-product-gallery__arrow--prev {
    left: 0;
  }

  .knr-product-gallery__arrow--next {
    right: 0;
  }

  .knr-product-gallery__arrow-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 0.375rem;
    height: 0.625rem;
  }

  .knr-product-gallery__arrow .knr-icon {
    max-width: none;
    rotate: 90deg;
  }

  .knr-product-gallery__arrow--next .knr-icon {
    rotate: -90deg;
  }

  .knr-product-gallery__arrow:focus-visible {
    outline: 1px solid currentcolor;
    outline-offset: -0.25rem;
  }

  .knr-product-gallery__progress {
    position: absolute;
    inset-inline: 0;
    bottom: calc(var(--knr-product-panel-overlap, 0px) + var(--knr-space-sm));
    z-index: 1;
    pointer-events: none;
  }

  .knr-product-gallery__progress .knr-carousel-progress {
    width: 6rem;
    background-color: var(--knr-color-bg);
  }

  .knr-product-gallery__carousel:not(:defined) .knr-product-gallery__arrow {
    display: none;
  }

  .knr-product-gallery__item picture {
    display: contents;
  }

  .knr-product-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--knr-gallery-ratio-mobile, 390 / 550);
    object-fit: cover;
  }

  .knr-product-gallery__image--placeholder {
    background-color: var(--knr-color-surface);
  }

  @media (min-width: 990px) {
    .knr-product-gallery__labels {
      display: none;
    }

    .knr-product-gallery__carousel {
      display: contents;
    }

    .knr-product-gallery__arrow,
    .knr-product-gallery__progress {
      display: none;
    }

    .knr-product-gallery {
      display: grid;
      grid-column: 1 / -1;
      grid-row: 1;
      grid-template-columns: subgrid;
    }

    .knr-product-gallery__list {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      column-gap: var(--knr-gallery-gap);
      row-gap: var(--knr-gallery-gap);
      overflow: visible;
    }

    .knr-product-gallery__item:first-child {
      grid-column: 1 / -1;
    }

    .knr-product-gallery__item:first-child .knr-product-gallery__image {
      aspect-ratio: var(--knr-gallery-ratio-hero, 1440 / 760);
    }

    .knr-product-gallery__zoom {
      display: grid;
    }

    .knr-product-gallery__item:first-child .knr-product-gallery__zoom {
      right: calc(var(--knr-product-panel-width) + var(--knr-gutter) + var(--knr-space-xs));
    }

    .knr-product-gallery__item:nth-child(2n) {
      grid-column: 1;
    }

    .knr-product-gallery__item:nth-child(2n + 3) {
      grid-column: 2;
    }

    .knr-product-gallery__image {
      aspect-ratio: var(--knr-gallery-ratio-desktop, 468 / 609);
    }

    .knr-product-gallery__item.knr-product-gallery__item--wide {
      grid-column: 1 / 3;
    }

    .knr-product-gallery__item--wide .knr-product-gallery__image {
      aspect-ratio: 952 / 609;
    }
  }
{% endstylesheet %}
