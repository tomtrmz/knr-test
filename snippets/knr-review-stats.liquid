{% doc %}
  @param {object[]} reviews - The product's custom.reviews value (knr_review entries)

  @example
  {% capture stats %}{% render 'knr-review-stats', reviews: reviews %}{% endcapture %}
  {% assign stats = stats | split: '|' %}
{% enddoc %}

{%- liquid
  assign count = 0
  assign sum = 0
  assign n1 = 0
  assign n2 = 0
  assign n3 = 0
  assign n4 = 0
  assign n5 = 0

  for review in reviews
    assign rating = review.rating.value | plus: 0
    if rating < 1 or rating > 5
      continue
    endif
    assign count = count | plus: 1
    assign sum = sum | plus: rating
    case rating
      when 1
        assign n1 = n1 | plus: 1
      when 2
        assign n2 = n2 | plus: 1
      when 3
        assign n3 = n3 | plus: 1
      when 4
        assign n4 = n4 | plus: 1
      when 5
        assign n5 = n5 | plus: 1
    endcase
  endfor

  echo count | append: '|' | append: sum | append: '|' | append: n1 | append: '|' | append: n2 | append: '|' | append: n3 | append: '|' | append: n4 | append: '|' | append: n5
-%}
