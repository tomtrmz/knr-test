{% doc %}
  @param {number} rating - The rating value, e.g. 4.7
  @param {number} [scale_max] - The maximum of the scale, 5 by default

  @example
  {% render 'knr-rating-stars', rating: 4.7 %}
{% enddoc %}

{%- liquid
  assign max = scale_max | default: 5
  assign percent = rating | times: 100.0 | divided_by: max
  assign rating_rounded = rating | round: 1
  assign rating_label = 'knr.product.rating_label' | t: rating: rating_rounded, max: max
-%}

