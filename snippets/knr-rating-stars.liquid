<span class="knr-rating-stars" role="img" aria-label="{{ rating_label }}" style="--knr-rating-percent: {{ percent }}%;">
  <span class="knr-rating-stars__row" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg class="knr-rating-stars__star" viewBox="0 0 12 12" fill="none" stroke="currentColor" focusable="false">
        <path transform="translate(1.29 1.5)" d="{{ star_path }}" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    {%- endfor -%}
  </span>
  <span class="knr-rating-stars__row knr-rating-stars__row--filled" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg class="knr-rating-stars__star" viewBox="0 0 12 12" fill="currentColor" focusable="false">
        <path transform="translate(1.29 1.5)" d="{{ star_path }}"/>
      </svg>
    {%- endfor -%}
  </span>
</span>

{% stylesheet %}
  .knr-rating-stars {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    color: var(--knr-color-accent);
  }

  .knr-rating-stars__row {
    display: flex;
  }

  .knr-rating-stars__row--filled {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--knr-rating-percent);
    overflow: hidden;
  }

  .knr-rating-stars__star {
    display: block;
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
  }
{% endstylesheet %}
