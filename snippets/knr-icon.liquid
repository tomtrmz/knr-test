{% stylesheet %}
  .knr-icon {
    display: block;
    width: var(--knr-icon-size);
    height: var(--knr-icon-size);
    flex-shrink: 0;
  }

  .knr-icon--chevron-down {
    width: 0.625rem;
    height: 0.375rem;
  }
{% endstylesheet %}
