{% doc %}
  @param {string} name - One of: location, account, search, cart, menu, close, chevron-down, compare, plus, filter, facebook, instagram, tiktok, linkedin
  @param {string} [class] - Optional extra class

  @example
  {% render 'knr-icon', name: 'cart' %}
{% enddoc %}

{%- case name -%}
  {%- when 'location' -%}
    {%- assign view_box = '0 0 12 15' -%}
  {%- when 'account' -%}
    {%- assign view_box = '0 0 15 14' -%}
  {%- when 'search' -%}
    {%- assign view_box = '0 0 14 14' -%}
  {%- when 'cart' -%}
    {%- assign view_box = '0 0 13 14' -%}
  {%- when 'menu' -%}
    {%- assign view_box = '0 0 16 5' -%}
  {%- when 'close' -%}
    {%- assign view_box = '0 0 12 12' -%}
  {%- when 'chevron-down' -%}
    {%- assign view_box = '0 0 10 6' -%}
  {%- when 'compare' -%}
    {%- assign view_box = '0 0 12 11' -%}
  {%- when 'plus' -%}
    {%- assign view_box = '0 0 14 14' -%}
  {%- when 'filter' -%}
    {%- assign view_box = '0 0 15 10' -%}
  {%- when 'facebook', 'instagram', 'tiktok', 'linkedin' -%}
    {%- assign view_box = '0 0 20 20' -%}
{%- endcase -%}

<svg
  class="knr-icon knr-icon--{{ name }} {{ class }}"
  viewBox="{{ view_box }}"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
