{%- liquid
  assign interval = section.settings.interval | times: 1000
-%}

<knr-reassurance
  class="knr-reassurance-bar full-width"
  role="region"
  aria-label="{{ 'knr.reassurance.label' | t | escape }}"
  data-interval="{{ interval }}"
  data-label-go-to="{{ 'knr.reassurance.go_to' | t: index: '[index]' }}"
  data-class-prefix="knr-reassurance-bar"
  data-media="(max-width: 989px)"
  style="--knr-reassurance-bar-columns: {{ section.blocks.size | at_least: 1 }};{% if section.settings.background %} --knr-reassurance-bar-bg: {{ section.settings.background }};{% endif %}"
>
  <div class="knr-reassurance-bar__items" data-knr-slides aria-live="off">
    {% content_for 'blocks' %}
  </div>
</knr-reassurance>

<script src="{{ 'knr-reassurance.js' | asset_url }}" defer></script>

{% stylesheet %}
  .knr-reassurance-bar {
    display: block;

    padding: var(--knr-space-3xl) var(--knr-gutter) calc(var(--knr-space-3xl) - 0.5rem);
    background-color: var(--knr-reassurance-bar-bg, var(--knr-color-sand));
    text-align: center;
  }

  .knr-reassurance-bar__items > .shopify-block {
    display: contents;
  }

  @media (max-width: 989px) {
    .knr-reassurance-bar:defined .knr-reassurance-bar__items {
      display: grid;
    }

    .knr-reassurance-bar:defined .knr-reassurance-bar-item {
      grid-area: 1 / 1;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 600ms ease,
        visibility 600ms ease;
    }

    .knr-reassurance-bar:defined .knr-reassurance-bar-item.is-active {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knr-reassurance-bar:defined .knr-reassurance-bar-item {
      transition: none;
    }
  }

  .knr-reassurance-bar__controls {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--knr-space-lg) - 0.5rem);
  }

  .knr-reassurance-bar__dots {
    display: flex;
    gap: var(--knr-space-xs);
  }

  .knr-reassurance-bar__dot {
    display: flex;
    align-items: center;
    width: 1rem;
    height: 1.0625rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .knr-reassurance-bar__dot::before {
    content: '';
    width: 100%;
    height: 1px;
    background-color: var(--knr-color-accent);
  }

  .knr-reassurance-bar__dot[aria-current='true']::before {
    background-color: var(--knr-color-text);
  }

  .knr-reassurance-bar__dot:focus-visible {
    outline: 1px solid var(--knr-color-text);
    outline-offset: 2px;
  }

  @media (min-width: 990px) {
    .knr-reassurance-bar {
      padding-bottom: var(--knr-space-3xl);
    }

    .knr-reassurance-bar__items {
      display: grid;
      grid-template-columns: repeat(var(--knr-reassurance-bar-columns), minmax(0, 1fr));
      gap: var(--knr-space-3xl);
    }

    .knr-reassurance-bar__controls {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reassurance bar",
  "class": "knr-reassurance-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#DCD5C3"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Duration of each item (mobile)",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "_knr-reassurance-bar-item"
    }
  ],
  "presets": [
    {
      "name": "Reassurance bar",
      "blocks": [
        {
          "type": "_knr-reassurance-bar-item"
        },
        {
          "type": "_knr-reassurance-bar-item"
        },
        {
          "type": "_knr-reassurance-bar-item"
        },
        {
          "type": "_knr-reassurance-bar-item"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
