{%- liquid
  assign is_transparent = false
  if section.settings.transparent_on_product and template.name == 'product'
    assign is_transparent = true
  endif

  assign logo = settings.logo
  if is_transparent and settings.logo_inverse
    assign logo = settings.logo_inverse
  endif

  assign menu_links = section.settings.menu.links
  assign drawer_id = 'knr-menu-drawer-' | append: section.id
  assign logo_sizes = '(min-width: 990px) ' | append: section.settings.logo_width | append: 'px, ' | append: section.settings.logo_width_mobile | append: 'px'

  assign cart_label = 'knr.header.cart' | t
  if cart.item_count > 0
    assign cart_items_label = 'knr.header.cart_items' | t: count: cart.item_count
    assign cart_label = cart_label | append: ', ' | append: cart_items_label
  endif
-%}

<header
  class="knr-header full-width{% if is_transparent %} knr-header--transparent{% endif %}"
  style="--knr-logo-width: {{ section.settings.logo_width }}px; --knr-logo-width-mobile: {{ section.settings.logo_width_mobile }}px; --knr-header-transparent-fg: {{ section.settings.transparent_text_color }};"
>
  <div class="knr-header__inner">
    <a href="{{ routes.root_url }}" class="knr-header__logo">
      {%- if logo -%}
        {{
          logo
          | image_url: width: 480
          | image_tag:
            alt: shop.name,
            class: 'knr-header__logo-image',
            widths: '160, 240, 320, 480',
            sizes: logo_sizes,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="knr-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if menu_links.size > 0 -%}
      <nav class="knr-header__nav" aria-label="{{ 'knr.header.main_navigation' | t }}">
        <ul class="knr-header__menu" role="list">
          {%- for link in menu_links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="knr-header__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="knr-header__icons">
      {%- if section.settings.store_locator_url != blank -%}
        <a
          href="{{ section.settings.store_locator_url }}"
          class="knr-header__icon-button"
          aria-label="{{ 'knr.header.store_locator' | t }}"
        >
          {% render 'knr-icon', name: 'location' %}
        </a>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="knr-header__icon-button knr-header__icon-button--account"
          aria-label="{{ 'knr.header.account' | t }}"
        >
          {% render 'knr-icon', name: 'account' %}
        </a>
      {%- endif -%}

      <a href="{{ routes.search_url }}" class="knr-header__icon-button" aria-label="{{ 'knr.header.search' | t }}">
        {% render 'knr-icon', name: 'search' %}
      </a>

      <knr-cart-icon class="knr-header__cart" data-knr-cart-section="{{ section.id }}">
        <a
          href="{{ routes.cart_url }}"
          class="knr-header__icon-button"
          aria-label="{{ cart_label }}"
        >
          {% render 'knr-icon', name: 'cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="knr-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </knr-cart-icon>

      {%- if menu_links.size > 0 -%}
        <button
          type="button"
          class="knr-header__icon-button knr-header__icon-button--burger"
          popovertarget="{{ drawer_id }}"
          aria-label="{{ 'knr.header.open_menu' | t }}"
        >
          {% render 'knr-icon', name: 'menu' %}
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if menu_links.size > 0 -%}
    <div id="{{ drawer_id }}" class="knr-header__drawer" popover>
      <button
        type="button"
        class="knr-header__icon-button knr-header__icon-button--close"
        popovertarget="{{ drawer_id }}"
        popovertargetaction="hide"
        aria-label="{{ 'knr.header.close_menu' | t }}"
      >
        {% render 'knr-icon', name: 'close' %}
      </button>

      <nav aria-label="{{ 'knr.header.main_navigation' | t }}">
        <ul class="knr-header__drawer-menu" role="list">
          {%- for link in menu_links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="knr-header__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  {%- endif -%}
</header>

<script src="{{ 'knr-cart-icon.js' | asset_url }}" defer></script>

{% stylesheet %}
  .knr-header {
    --knr-header-fg: var(--knr-color-text);
    --knr-header-bg: var(--knr-color-bg);

    position: relative;
    z-index: 10;
    color: var(--knr-header-fg);
    background-color: var(--knr-header-bg);
    font-size: var(--knr-fs-xs);
  }

  .knr-header--transparent {
    --knr-header-fg: var(--knr-header-transparent-fg);
    --knr-header-bg: transparent;

    position: absolute;
    top: 0;
    inset-inline: 0;
  }

  .knr-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--knr-space-md);
    min-height: var(--knr-header-height);
    padding-inline: var(--knr-header-gutter);
  }

  .knr-header__logo {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .knr-header__logo-image {
    width: var(--knr-logo-width-mobile);
    height: auto;
  }

  .knr-header__logo-text {
    font-size: var(--knr-fs-lg);
    line-height: 1;
  }

  .knr-header__nav {
    display: none;
  }

  .knr-header__menu {
    display: flex;
    gap: var(--knr-space-lg);
    padding: 0;
    list-style: none;
  }

  .knr-header__link {
    color: inherit;
    text-decoration: none;
  }

  .knr-header__link:hover,
  .knr-header__link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .knr-header__icons {
    display: flex;
    align-items: center;
    gap: var(--knr-space-2xs);
  }

  .knr-header__icon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--knr-space-2xs);
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .knr-header__icon-button--account {
    display: none;
  }

  .knr-header__icon-button--account .knr-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .knr-header__link:focus-visible,
  .knr-header__icon-button:focus-visible {
    outline: 1px solid currentcolor;
    outline-offset: 2px;
  }

  .knr-header__cart-count {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    min-width: 0.875rem;
    height: 0.875rem;
    padding-inline: 0.2rem;
    border-radius: 999px;
    background-color: var(--knr-header-fg);
    color: var(--knr-header-bg);
    font-size: 0.5625rem;
    line-height: 1;
  }

  .knr-header--transparent .knr-header__cart-count {
    color: var(--knr-color-text);
  }

  .knr-header__cart {
    display: flex;
  }

  .knr-header__drawer {
    inset: 0 0 0 auto;
    width: min(100%, 22rem);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--knr-space-md) var(--knr-gutter);
    border: 0;
    background-color: var(--knr-color-bg);
    color: var(--knr-color-text);
  }

  .knr-header__drawer:popover-open {
    display: flex;
    flex-direction: column;
    gap: var(--knr-space-xl);
  }

  .knr-header__drawer::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  .knr-header__icon-button--close {
    align-self: flex-end;
  }

  .knr-header__drawer-menu {
    display: flex;
    flex-direction: column;
    gap: var(--knr-space-lg);
    padding: 0;
    list-style: none;
    font-size: var(--knr-fs-lg);
  }

  @media (min-width: 990px) {
    .knr-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .knr-header__nav {
      display: block;
    }

    .knr-header__logo-image {
      width: var(--knr-logo-width);
    }

    .knr-header__icon-button--account {
      display: inline-flex;
    }

    .knr-header__icons {
      justify-self: end;
    }

    .knr-header__icon-button--burger {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "knr-header-section",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "paragraph",
      "content": "The logo images are in Theme settings > Logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 60,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 130
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "store_locator_url",
      "label": "Store locator link"
    },
    {
      "type": "header",
      "content": "Product page"
    },
    {
      "type": "checkbox",
      "id": "transparent_on_product",
      "label": "Transparent header on product pages",
      "info": "The header overlays the first product image",
      "default": true
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "Text color when transparent",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
