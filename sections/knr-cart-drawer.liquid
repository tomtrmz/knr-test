{%- liquid
  assign title_id = 'KnrCartDrawerTitle-' | append: section.id
  assign samples_panel_id = 'KnrCartSamples-' | append: section.id

  capture cart_count
    render 'knr-cart-count'
  endcapture
  assign cart_count = cart_count | plus: 0

  capture total
    render 'knr-cart-qualifying-total'
  endcapture
  assign total = total | plus: 0

  assign tiers = section.blocks
  assign tier_count = tiers.size
  assign fill = 100
  assign message = section.settings.final_message
  assign next_found = false
  assign previous_threshold = 0
  assign previous_position = 0
  assign gift_product = blank
  assign gift_threshold = 0
  assign samples_tier = blank
  assign samples_threshold = 0

  for tier in tiers
    assign threshold = tier.settings.threshold | default: 0 | times: 100
    assign position = forloop.index0 | times: 2 | plus: 1 | times: 50.0 | divided_by: tier_count

    if next_found == false and total < threshold
      assign next_found = true
      assign span = threshold | minus: previous_threshold
      assign progress = total | minus: previous_threshold | times: 1.0 | divided_by: span
      assign fill = position | minus: previous_position | times: progress | plus: previous_position
      assign remaining = threshold | minus: total | money
      assign message = tier.settings.message | replace: '[amount]', remaining | replace: '[count]', tier.settings.samples_count
    endif

    if tier.settings.reward == 'gift' and tier.settings.gift_product != blank
      assign gift_product = tier.settings.gift_product
      assign gift_threshold = threshold
    elsif tier.settings.reward == 'samples'
      assign samples_tier = tier
      assign samples_threshold = threshold
    endif

    assign previous_threshold = threshold
    assign previous_position = position
  endfor

  assign fill = fill | round: 2
  assign goal = previous_threshold

  assign gift_active = false
  if gift_product != blank and total >= gift_threshold
    assign gift_active = true
  endif

  assign samples_collection = section.settings.samples_collection
  assign samples_label = samples_tier.settings.label | replace: '[count]', samples_tier.settings.samples_count
  assign samples_limit = 0
  if samples_tier != blank and samples_collection.products_count > 0 and total >= samples_threshold
    assign samples_limit = samples_tier.settings.samples_count
  endif

  assign gift_quantity = 0
  assign gift_updates = ''
  assign updates = ''
  assign samples_kept = 0
  for item in cart.items
    assign line_update = item.key | json | append: ':0,'
    if gift_product != blank and item.product_id == gift_product.id
      assign gift_key = item.key | json
      assign gift_quantity = gift_quantity | plus: item.quantity
      assign gift_updates = gift_updates | append: line_update
    elsif item.properties._knr_gift != blank
      assign updates = updates | append: line_update
    elsif item.properties._knr_sample != blank
      assign room = samples_limit | minus: samples_kept
      if room < 1
        assign updates = updates | append: line_update
      else
        if item.quantity > 1
          assign single_update = item.key | json | append: ':1,'
          assign updates = updates | append: single_update
        endif
        assign samples_kept = samples_kept | plus: 1
      endif
    endif
  endfor

  assign gift_declined = false
  if cart.attributes._knr_gift_declined == 'true'
    assign gift_declined = true
  endif

  assign gift_add = blank
  assign reset_declined = false
  if gift_active
    if gift_quantity == 0 and gift_declined == false and gift_product.selected_or_first_available_variant.available
      assign gift_add = gift_product.selected_or_first_available_variant.id
    elsif gift_quantity > 1
      assign updates = updates | append: gift_updates | append: gift_key | append: ':1,'
    endif
  else
    assign updates = updates | append: gift_updates
    assign reset_declined = gift_declined
  endif

  assign sync = blank
  if gift_add != blank
    assign sync = '{"add":[{"id":' | append: gift_add | append: ',"quantity":1,"properties":{"_knr_gift":"1"}}]}'
  elsif updates != '' or reset_declined
    assign sync = '{"update":{"updates":{' | append: updates | append: '}'
    if reset_declined
      assign sync = sync | append: ',"attributes":{"_knr_gift_declined":""}'
    endif
    assign sync = sync | append: '}}' | replace: ',}', '}'
  endif
-%}

<knr-cart-drawer
  class="knr-cart-drawer"
  data-knr-cart-section="{{ section.id }}"
  data-error-message="{{ 'knr.cart_drawer.error' | t | escape }}"
>
  <dialog class="knr-cart-drawer__dialog" aria-labelledby="{{ title_id }}" data-knr-cart-drawer-dialog>
    <div class="knr-cart-drawer__panel" data-knr-cart-drawer-content>
      <div class="knr-cart-drawer__header">
        <h2 id="{{ title_id }}" class="knr-cart-drawer__title">
          <span class="knr-cart-drawer__cart-icon" aria-hidden="true">
            {% render 'knr-icon', name: 'cart' %}
            {%- if cart_count > 0 -%}
              <span class="knr-cart-drawer__count">{{ cart_count }}</span>
            {%- endif -%}
          </span>
          {{ 'knr.cart_drawer.title' | t }}
          {%- if cart_count > 0 -%}
            <span class="knr-cart-drawer__count-label">({{ 'knr.cart_drawer.items_count' | t: count: cart_count }})</span>
          {%- endif -%}
        </h2>
        <form method="dialog">
          <button type="submit" class="knr-cart-drawer__close" aria-label="{{ 'knr.cart_drawer.close' | t | escape }}" data-knr-focus="close">
            {% render 'knr-icon', name: 'close' %}
          </button>
        </form>
      </div>

      <p class="knr-cart-drawer__error" role="alert" data-knr-cart-drawer-error hidden></p>

      {%- if sync != blank -%}
        <script type="application/json" data-knr-cart-sync>{{ sync }}</script>
      {%- endif -%}

      {%- if cart_count > 0 -%}
        {%- if tier_count > 0 -%}
          <div class="knr-cart-progress" data-knr-cart-progress>
            <p class="knr-cart-progress__message" aria-live="polite" data-knr-patch="content">{{ message }}</p>
            <div class="knr-cart-progress__tiers">
              <div
                class="knr-cart-progress__track"
                role="progressbar"
                aria-label="{{ 'knr.cart_drawer.progress_label' | t }}"
                aria-valuemin="0"
                aria-valuemax="{{ goal | divided_by: 100 }}"
                aria-valuenow="{{ total | at_most: goal | divided_by: 100 }}"
                aria-valuetext="{{ total | money }}"
                data-knr-patch
              >
                <div class="knr-cart-progress__fill" style="--knr-progress: {{ fill }}%;" data-knr-patch></div>
              </div>
              <ol class="knr-cart-progress__steps" role="list">
                {%- for block in tiers -%}
                  {%- liquid
                    assign threshold = block.settings.threshold | default: 0 | times: 100
                    assign reached = false
                    if total >= threshold
                      assign reached = true
                    endif
                  -%}
                  {% render 'knr-cart-tier', block: block, reached: reached %}
                {%- endfor -%}
              </ol>
            </div>
          </div>
        {%- endif -%}

        <div class="knr-cart-drawer__body">
          <ul class="knr-cart-drawer__items" role="list">
            {%- for item in cart.items -%}
              {%- if item.properties._knr_gift == blank and item.properties._knr_sample == blank and item.product_id != gift_product.id -%}
                {% render 'knr-cart-item', item: item %}
              {%- endif -%}
            {%- endfor -%}
            {%- for item in cart.items -%}
              {%- if item.properties._knr_gift != blank or item.product_id == gift_product.id -%}
                {% render 'knr-cart-item', item: item, gift: true %}
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {%- if samples_limit > 0 -%}
            {% render 'knr-cart-samples',
              title: section.settings.samples_title,
              subtitle: samples_label,
              limit: samples_limit,
              panel_id: samples_panel_id
            %}
          {%- endif -%}
        </div>

        <div class="knr-cart-drawer__footer">
          {%- if section.settings.show_view_cart -%}
            <a href="{{ routes.cart_url }}" class="knr-cart-drawer__button knr-cart-drawer__button--secondary">
              {{- 'knr.cart_drawer.view_cart' | t -}}
            </a>
          {%- endif -%}
          <form action="{{ routes.cart_url }}" method="post" class="knr-cart-drawer__checkout">
            <button type="submit" name="checkout" class="knr-cart-drawer__button">
              {{ 'knr.cart_drawer.checkout' | t }}
              <span class="knr-cart-drawer__separator" aria-hidden="true"></span>
              {{ cart.total_price | money }}
            </button>
          </form>
          {%- if section.settings.footer_text != blank -%}
            <p class="knr-cart-drawer__note">{{ section.settings.footer_text }}</p>
          {%- endif -%}
        </div>

        {%- if samples_limit > 0 -%}
          {% render 'knr-cart-samples-panel',
            id: samples_panel_id,
            title: section.settings.samples_title,
            collection: samples_collection,
            limit: samples_limit
          %}
        {%- endif -%}
      {%- else -%}
        <div class="knr-cart-drawer__empty">
          <p>{{ 'knr.cart_drawer.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="knr-cart-drawer__button knr-cart-drawer__button--secondary">
            {{- 'knr.cart_drawer.continue' | t -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </dialog>
</knr-cart-drawer>

<script src="{{ 'knr-cart-api.js' | asset_url }}" defer></script>
<script src="{{ 'knr-cart-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'knr-cart-samples.js' | asset_url }}" defer></script>

{% stylesheet %}
  .knr-cart-drawer__dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 31.25rem);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background-color: var(--knr-color-bg);
    color: var(--knr-color-text);
    translate: 100% 0;
    transition:
      translate 300ms ease,
      overlay 300ms ease allow-discrete,
      display 300ms ease allow-discrete;
  }

  .knr-cart-drawer__dialog[open] {
    translate: 0 0;
  }

  @starting-style {
    .knr-cart-drawer__dialog[open] {
      translate: 100% 0;
    }
  }

  .knr-cart-drawer__dialog::backdrop {
    background-color: rgb(0 0 0 / 0%);
    transition:
      background-color 300ms ease,
      overlay 300ms ease allow-discrete,
      display 300ms ease allow-discrete;
  }

  .knr-cart-drawer__dialog[open]::backdrop {
    background-color: rgb(0 0 0 / 50%);
  }

  @starting-style {
    .knr-cart-drawer__dialog[open]::backdrop {
      background-color: rgb(0 0 0 / 0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knr-cart-drawer__dialog,
    .knr-cart-drawer__dialog::backdrop {
      transition: none;
    }
  }

  .knr-cart-drawer__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .knr-cart-drawer__panel[aria-busy='true'] {
    cursor: progress;
  }

  .knr-cart-drawer__panel[aria-busy='true'] button {
    pointer-events: none;
  }

  .knr-cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--knr-space-md) 1.25rem var(--knr-space-md) var(--knr-space-lg);
    border-bottom: 1px solid var(--knr-color-line-strong);
  }

  .knr-cart-drawer__title {
    display: flex;
    align-items: center;
    gap: var(--knr-space-xs);
    margin: 0;
    font-size: var(--knr-fs-md);
    font-weight: 400;
    line-height: 1.375rem;
  }

  .knr-cart-drawer__cart-icon {
    position: relative;
    display: grid;
  }

  .knr-cart-drawer__cart-icon .knr-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .knr-cart-drawer__count {
    position: absolute;
    top: -0.375rem;
    right: -0.375rem;
    display: grid;
    place-items: center;
    min-width: 0.875rem;
    height: 0.875rem;
    padding-inline: 2px;
    border-radius: 999px;
    background-color: var(--knr-color-progress);
    font-size: var(--knr-fs-3xs);
    line-height: 1;
  }

  .knr-cart-drawer__count-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .knr-cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .knr-cart-drawer__close:focus-visible {
    outline: 1px solid currentcolor;
  }

  .knr-cart-drawer__error {
    margin: 0;
    padding: var(--knr-space-sm) 1.25rem;
    background-color: var(--knr-color-mist);
    color: var(--knr-color-error);
    font-size: var(--knr-fs-xs);
    line-height: var(--knr-lh-sm);
  }

  .knr-cart-progress {
    display: grid;
    gap: var(--knr-space-sm);
    padding: var(--knr-space-md);
    border-bottom: 1px solid var(--knr-color-line);
    background-color: var(--knr-color-mist);
  }

  .knr-cart-progress__message {
    margin: 0;
    font-size: var(--knr-fs-xs);
    line-height: var(--knr-lh-sm);
    text-align: center;
  }

  .knr-cart-progress__tiers {
    position: relative;
  }

  .knr-cart-progress__track {
    position: absolute;
    top: calc(0.9375rem - 2px);
    inset-inline: 0;
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background-color: var(--knr-color-bg);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 5%);
  }

  .knr-cart-progress__fill {
    width: var(--knr-progress);
    height: 100%;
    background-color: var(--knr-color-progress);
    transition: width 400ms ease;
  }

  .knr-cart-progress__steps {
    position: relative;
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .knr-cart-progress__fill {
      transition: none;
    }
  }

  .knr-cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-inline: 1.25rem;
  }

  .knr-cart-drawer__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knr-cart-drawer__footer {
    padding: var(--knr-space-md) 1.25rem 0.625rem;
  }

  .knr-cart-drawer__checkout {
    margin: 0;
  }

  .knr-cart-drawer__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--knr-space-xs);
    width: 100%;
    margin-bottom: var(--knr-space-xs);
    padding: calc(var(--knr-space-sm) - 1px) var(--knr-space-lg);
    border: 1px solid var(--knr-color-text);
    background-color: var(--knr-color-text);
    color: var(--knr-color-bg);
    font: inherit;
    font-size: var(--knr-fs-sm);
    font-weight: 500;
    line-height: var(--knr-lh-md);
    text-decoration: none;
    cursor: pointer;
  }

  .knr-cart-drawer__button--secondary {
    background-color: var(--knr-color-bg);
    color: var(--knr-color-text);
  }

  .knr-cart-drawer__button:focus-visible {
    outline: 1px solid var(--knr-color-text);
    outline-offset: 2px;
  }

  .knr-cart-drawer__separator {
    width: 1px;
    height: 0.75rem;
    background-color: currentcolor;
  }

  .knr-cart-drawer__note {
    margin: 0;
    color: var(--knr-color-text-light);
    font-size: var(--knr-fs-2xs);
    line-height: var(--knr-lh-xs);
    text-align: center;
  }

  .knr-cart-drawer__empty {
    display: grid;
    gap: var(--knr-space-md);
    padding: var(--knr-space-xl) 1.25rem;
    text-align: center;
  }

  .knr-cart-drawer__empty p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "class": "knr-cart-drawer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_view_cart",
      "label": "Show the \"View my cart\" button",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "footer_text",
      "label": "Text under the buttons",
      "default": "Les frais de livraison et codes promo s'appliquent lors du paiement"
    },
    {
      "type": "header",
      "content": "Reward tiers"
    },
    {
      "type": "collection",
      "id": "samples_collection",
      "label": "Free samples collection",
      "info": "Products customers can pick once the \"Free samples\" tier is reached. Keep it aligned with the samples discount."
    },
    {
      "type": "text",
      "id": "samples_title",
      "label": "Samples title",
      "default": "Choisissez vos échantillons offerts"
    },
    {
      "type": "inline_richtext",
      "id": "final_message",
      "label": "Message when every tier is reached",
      "default": "Félicitations, vous profitez de <strong>tous vos avantages</strong> !"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Reward tier",
      "settings": [
        {
          "type": "number",
          "id": "threshold",
          "label": "Threshold (€)",
          "info": "Amount of paid products, gift and samples excluded. Tiers must be in ascending order. Keep it aligned with the matching Shopify discount.",
          "default": 50
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "[count] is replaced by the number of samples.",
          "default": "Livraison offerte"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "sample",
              "label": "Sample"
            },
            {
              "value": "gift",
              "label": "Gift"
            }
          ],
          "default": "truck"
        },
        {
          "type": "inline_richtext",
          "id": "message",
          "label": "Message before the tier",
          "info": "[amount] is replaced by the amount left to reach the tier, [count] by the number of samples.",
          "default": "Plus que <strong>[amount]</strong> pour profiter de <strong>la livraison offerte</strong>"
        },
        {
          "type": "select",
          "id": "reward",
          "label": "Reward handled by the drawer",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "samples",
              "label": "Free samples"
            },
            {
              "value": "gift",
              "label": "Free product"
            }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "samples_count",
          "label": "Number of samples",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3,
          "visible_if": "{{ block.settings.reward == 'samples' }}"
        },
        {
          "type": "product",
          "id": "gift_product",
          "label": "Free product",
          "info": "Used when the reward is \"Free product\". Must be priced at 0 €: it is added to the cart automatically above the threshold."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Cart drawer",
      "blocks": {
        "shipping": {
          "type": "tier",
          "settings": {
            "threshold": 50,
            "label": "Livraison offerte",
            "icon": "truck",
            "message": "Plus que <strong>[amount]</strong> pour profiter de <strong>la livraison offerte</strong>",
            "reward": "none"
          }
        },
        "samples": {
          "type": "tier",
          "settings": {
            "threshold": 75,
            "label": "[count] échantillons offerts",
            "icon": "sample",
            "message": "Plus que <strong>[amount]</strong> pour recevoir <strong>[count] échantillons offerts</strong>",
            "reward": "samples",
            "samples_count": 3
          }
        },
        "gift": {
          "type": "tier",
          "settings": {
            "threshold": 100,
            "label": "Produit offert",
            "icon": "gift",
            "message": "Plus que <strong>[amount]</strong> pour recevoir <strong>un produit offert</strong>",
            "reward": "gift"
          }
        }
      },
      "block_order": ["shipping", "samples", "gift"]
    }
  ]
}
{% endschema %}
