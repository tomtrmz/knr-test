{%- liquid
  assign image = section.settings.image
  assign title = section.settings.title
  if section.settings.show_product_title and product and title != blank
    assign title = 'knr.newsletter.title_with_product' | t: product: product.title, title: title
  endif
  assign form_id = 'knr-newsletter-' | append: section.id
  assign image_alt = image.alt | default: ''
-%}

<div class="knr-newsletter full-width">
  <div class="knr-newsletter__media">
    {%- if image -%}
      {{
        image
        | image_url: width: 1440
        | image_tag:
          class: 'knr-newsletter__image',
          widths: '400, 600, 800, 1100, 1440',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'knr-newsletter__image knr-newsletter__image--placeholder' }}
    {%- endif -%}
  </div>

  <div class="knr-newsletter__content">
    {%- if title != blank -%}
      <h2 class="knr-newsletter__title">{{ title }}</h2>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'knr-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="true">

      {%- if form.posted_successfully? -%}
        <p class="knr-newsletter__message" role="status">{{ 'knr.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="knr-newsletter__fields">
          <input
            type="email"
            id="{{ form_id }}-email"
            class="knr-newsletter__input"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'knr.newsletter.email_label' | t | escape }}"
            aria-label="{{ 'knr.newsletter.email_label' | t | escape }}"
            autocomplete="email"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="{{ form_id }}-error"
            {% elsif section.settings.disclaimer != blank %}
              aria-describedby="{{ form_id }}-disclaimer"
            {% endif %}
          >
          <button type="submit" class="knr-newsletter__button">{{ 'knr.newsletter.submit' | t }}</button>
        </div>

        {%- if form.errors -%}
          <div id="{{ form_id }}-error" class="knr-newsletter__message knr-newsletter__message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p id="{{ form_id }}-disclaimer" class="knr-newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .knr-newsletter {
    display: grid;
    gap: var(--knr-space-lg);
    margin-bottom: var(--knr-section-space-2xl);
    padding-inline: var(--knr-gutter);
  }

  .knr-newsletter__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .knr-newsletter__image--placeholder {
    background-color: var(--knr-color-surface);
  }

  .knr-newsletter__title {
    margin: 0 0 var(--knr-space-xl);
    font-size: var(--knr-fs-2xl);
    font-weight: 400;
    line-height: var(--knr-lh-2xl);
  }

  .knr-newsletter__fields {
    display: grid;
    gap: var(--knr-space-md);
  }

  .knr-newsletter__input {
    min-width: 0;
    height: var(--knr-control-height);
    padding: 0.875rem var(--knr-space-lg);
    border: 1px solid var(--knr-color-sand);
    border-radius: 0;
    background-color: var(--knr-color-bg);
    color: var(--knr-color-text);
    font: inherit;
    font-size: var(--knr-fs-xs);
    line-height: var(--knr-lh-md);
  }

  .knr-newsletter__input::placeholder {
    color: var(--knr-color-text);
    opacity: 1;
  }

  .knr-newsletter__input:focus-visible {
    border-color: var(--knr-color-text);
    outline: none;
  }

  .knr-newsletter__button {
    height: var(--knr-control-height);
    padding: 0 var(--knr-space-lg);
    border: 1px solid var(--knr-color-text);
    border-radius: 0;
    background-color: var(--knr-color-text);
    color: var(--knr-color-bg);
    font: inherit;
    font-size: var(--knr-fs-xs);
    cursor: pointer;
    transition: opacity var(--knr-transition);
  }

  .knr-newsletter__button:hover {
    opacity: 0.85;
  }

  .knr-newsletter__button:focus-visible {
    outline: 1px solid var(--knr-color-text);
    outline-offset: 2px;
  }

  .knr-newsletter__message {
    margin: 0;
    font-size: var(--knr-fs-sm);
    line-height: var(--knr-lh-lg);
  }

  .knr-newsletter__message--error {
    margin-top: var(--knr-space-xs);
    color: var(--knr-color-error);
  }

  .knr-newsletter__message--error ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .knr-newsletter__disclaimer {
    margin: var(--knr-space-md) 0 0;
    font-size: var(--knr-fs-2xs);
    line-height: var(--knr-lh-xs);
  }

  .knr-newsletter__disclaimer a {
    color: inherit;
  }

  @media (min-width: 990px) {
    .knr-newsletter {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    .knr-newsletter__image {
      aspect-ratio: auto;
    }

    .knr-newsletter__content {
      align-self: center;
      justify-self: center;
      width: min(37.5rem, 100% - 2 * var(--knr-gutter));
    }

    .knr-newsletter__title {
      font-size: var(--knr-fs-3xl);
      line-height: var(--knr-lh-3xl);
    }

    .knr-newsletter__fields {
      grid-template-columns: minmax(0, 1fr) 10rem;
      gap: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "class": "knr-newsletter-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Cropped to 16:9 on mobile: set its focal point."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "L'alliance de la science botanique et du luxe naturel pour une peau visiblement rajeunie en 4 semaines."
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "label": "Prefix the title with the product title",
      "info": "Product pages only. E.g. \"Sérum précieux régénérant — …\"",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "disclaimer",
      "label": "Text under the form",
      "default": "Formule brevetée, testée dermatologiquement, 97 % d'ingrédients d'origine naturelle."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
